# Copy to .env.local. Never commit credentials. Restart after changing settings.
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local Qwen via LM Studio's OpenAI-compatible server (no cloud API key).
# Set LLM_PROVIDER=local and start the model server before running inspections.
LOCAL_MODEL=qwen3-4b-instruct-2507
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Optional alternative; used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Set a tool-capable model ID available to your API project; pin it for evaluation.
OPENAI_MODEL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=governance_demo
MYSQL_USER=governance_reader
MYSQL_PASSWORD=
# Optional comma-separated table allowlist. Blank selects tables in this schema.
MYSQL_ALLOWED_TABLES=
MYSQL_QUERY_TIMEOUT_MS=3000
MYSQL_CONNECT_TIMEOUT=5
# Optional verified TLS. A client certificate and key must be supplied together.
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=
# Optional pricing estimate; use published prices for the pinned model.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
GEMINI_INPUT_PRICE_PER_MILLION=
GEMINI_OUTPUT_PRICE_PER_MILLION=
# Privacy: seeded selection from at most 100 shape descriptors, never raw values.
PRIVACY_SAMPLE_RATE=0.05
PRIVACY_MAX_SAMPLES=10
PRIVACY_SAMPLE_SEED=42
